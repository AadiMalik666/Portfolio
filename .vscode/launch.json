{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Open in Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "file://${workspaceFolder}/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Open in Edge",
            "type": "msedge",
            "request": "launch",
            "url": "file://${workspaceFolder}/index.html",
            "webRoot": "${workspaceFolder}"
        }
    ]
}